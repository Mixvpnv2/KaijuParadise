-- Store original configurations for all guns
local originalConfigs = {}
local activeGuns = {}

-- Function to modify gun configurations
local function modifyGunConfig(gunName, fireRate, enabled)
    local gunFolder = ReplicatedStorage.Players[localPlayer.Name].Inventory[gunName]
    if not gunFolder then return end
    
    local settingsModule = gunFolder:FindFirstChild("SettingsModule")
    if not settingsModule then return end

    local config = require(settingsModule)
    
    if enabled then
        -- Store original config if not already stored
        if not originalConfigs[gunName] then
            originalConfigs[gunName] = {
                FireRate = config.FireRate,
                FireMode = config.FireMode,
                FireModes = table.clone(config.FireModes)
            }
        end
        
        -- Apply rapid fire settings
        config.FireMode = "Auto"
        config.FireModes = {"Auto"}
        config.FireRate = fireRate
        
        -- Track modified guns
        activeGuns[gunName] = true
    else
        -- Restore original settings
        if originalConfigs[gunName] then
            config.FireRate = originalConfigs[gunName].FireRate
            config.FireMode = originalConfigs[gunName].FireMode
            config.FireModes = table.clone(originalConfigs[gunName].FireModes)
            activeGuns[gunName] = nil
        end
    end
end

-- Function to handle all guns in inventory
local function updateAllGuns(fireRate, enabled)
    local inventory = ReplicatedStorage.Players[localPlayer.Name].Inventory
    for _, gunFolder in pairs(inventory:GetChildren()) do
        if gunFolder:FindFirstChild("SettingsModule") then
            modifyGunConfig(gunFolder.Name, fireRate, enabled)
        end
    end
end

