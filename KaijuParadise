-- Crosshair configuration
local crosshairConfig = {
    Visible = false,
    Size = 20,
    Thickness = 1,
    Color = Color3.fromRGB(0, 255, 0),
    Transparency = 1,
    Gap = 5,  -- Added gap configuration
    ToMouse = false
}

-- Crosshair objects
local HorizontalLineLeft = Drawing.new("Line")
local HorizontalLineRight = Drawing.new("Line")
local VerticalLineTop = Drawing.new("Line")
local VerticalLineBottom = Drawing.new("Line")

local function UpdateCrosshair()
    local Center = Camera.ViewportSize / 2
    local Real_Size = crosshairConfig.Size / 2
    local Gap = crosshairConfig.Gap / 2

    -- Update common properties
    for _, line in pairs({HorizontalLineLeft, HorizontalLineRight, VerticalLineTop, VerticalLineBottom}) do
        line.Visible = crosshairConfig.Visible
        line.Thickness = crosshairConfig.Thickness
        line.Color = crosshairConfig.Color
        line.Transparency = crosshairConfig.Transparency
    end

    if crosshairConfig.ToMouse then
        local MousePos = UserInputService:GetMouseLocation()
        -- Horizontal lines
        HorizontalLineLeft.From = Vector2.new(MousePos.X - Real_Size, MousePos.Y)
        HorizontalLineLeft.To = Vector2.new(MousePos.X - Gap, MousePos.Y)
        HorizontalLineRight.From = Vector2.new(MousePos.X + Gap, MousePos.Y)
        HorizontalLineRight.To = Vector2.new(MousePos.X + Real_Size, MousePos.Y)
        
        -- Vertical lines
        VerticalLineTop.From = Vector2.new(MousePos.X, MousePos.Y - Real_Size)
        VerticalLineTop.To = Vector2.new(MousePos.X, MousePos.Y - Gap)
        VerticalLineBottom.From = Vector2.new(MousePos.X, MousePos.Y + Gap)
        VerticalLineBottom.To = Vector2.new(MousePos.X, MousePos.Y + Real_Size)
    else
        -- Horizontal lines
        HorizontalLineLeft.From = Vector2.new(Center.X - Real_Size, Center.Y)
        HorizontalLineLeft.To = Vector2.new(Center.X - Gap, Center.Y)
        HorizontalLineRight.From = Vector2.new(Center.X + Gap, Center.Y)
        HorizontalLineRight.To = Vector2.new(Center.X + Real_Size, Center.Y)
        
        -- Vertical lines
        VerticalLineTop.From = Vector2.new(Center.X, Center.Y - Real_Size)
        VerticalLineTop.To = Vector2.new(Center.X, Center.Y - Gap)
        VerticalLineBottom.From = Vector2.new(Center.X, Center.Y + Gap)
        VerticalLineBottom.To = Vector2.new(Center.X, Center.Y + Real_Size)
    end
end

-- Crosshair update loop
RunService.Heartbeat:Connect(function()
    if UserInputService:GetFocusedTextBox() then
        crosshairConfig.Visible = false
