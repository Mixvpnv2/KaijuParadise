-- WaterWalk System
local WaterWalkFolder = workspace:FindFirstChild("WaterWalk") or Instance.new("Folder", workspace)
WaterWalkFolder.Name = "WaterWalk"

local function createWaterPlatform(position)
    local platform = Instance.new("Part")
    platform.Size = Vector3.new(60, 1, 60)
    platform.Anchored = true
    platform.CanQuery = false
    platform.CanTouch = false
    platform.Material = Enum.Material.Metal
    platform.Position = position
    platform.Parent = WaterWalkFolder
    platform.Transparency = 1
    return platform
end

local function cleanWaterWalk()
    for _, v in pairs(WaterWalkFolder:GetChildren()) do
        if v:IsA("Part") then
            v:Destroy()
        end
    end
end

local function waterWalkEnabled(enable)
    if enable then
        local rayparams = RaycastParams.new()
        rayparams.FilterType = Enum.RaycastFilterType.Exclude
        
        local characterConnection
        local heartbeatConnection
        
        local function setupCharacter()
            local character = localPlayer.Character
            if not character then
                character = localPlayer.CharacterAdded:Wait()
            end
            return character
        end

        characterConnection = localPlayer.CharacterAdded:Connect(function()
            setupCharacter()
        end)

        heartbeatConnection = RunService.Heartbeat:Connect(function()
            local character = setupCharacter()
            if not character then return end
            
            local head = character:FindFirstChild("Head")
            if not head then return end

            -- Update filter list
            rayparams.FilterDescendantsInstances = {character}
            
            -- Check for ViewModel
            local viewModel = camera:FindFirstChild("ViewModel")
            if viewModel then
                table.insert(rayparams.FilterDescendantsInstances, viewModel)
            end

            -- Calculate ray parameters
            local rayOrigin = head.Position 
                + Vector3.new(0, 150, 0) 
                + camera.CFrame.LookVector * 5
                
            local rayDirection = Vector3.new(0, -300, 0)

            -- Perform raycast
            local rayResult = workspace:Raycast(rayOrigin, rayDirection, rayparams)
            
            if rayResult and rayResult.Material == Enum.Material.Water then
                createWaterPlatform(rayResult.Position)
            end
        end)

        return function()
            characterConnection:Disconnect()
            heartbeatConnection:Disconnect()
            cleanWaterWalk()
        end
    else
        cleanWaterWalk()
    end
end

